#!/bin/sh
# Blocks commits that add secret-looking strings. Enable once per clone:
#   git config core.hooksPath .githooks
NODE_BIN="${ZOOMATCH_NODE:-}"
if [ -z "$NODE_BIN" ]; then
  NODE_BIN="$(command -v node 2>/dev/null)"
fi
if [ -z "$NODE_BIN" ] && [ -n "$LOCALAPPDATA" ]; then
  # Windows: Node bundled with Zed when it is not on PATH.
  for candidate in "$LOCALAPPDATA"/Zed/node/node-v*/node.exe; do
    [ -x "$candidate" ] && NODE_BIN="$candidate"
  done
fi
if [ -z "$NODE_BIN" ]; then
  echo "pre-commit: no encontré node; define ZOOMATCH_NODE con la ruta a node." >&2
  exit 1
fi
exec "$NODE_BIN" --no-warnings scripts/secrets-check.mts --staged
