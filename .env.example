# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). También se acepta NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto HMAC para hashear matrículas (mínimo 32 caracteres)
# Genera uno con: openssl rand -hex 32
MATRICULA_HMAC_SECRET=

# Opcionales
# Orígenes extra permitidos para CORS, separados por coma (el mismo origen siempre se permite)
CORS_ALLOWED_ORIGINS=
# Rate limiting distribuido. Si se omite, las APIs quedan en modo fail-open.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Solo para el crawler de literatura (scripts/literature). Nunca en Vercel.
FIRECRAWL_API_KEY=

# Solo para scripts locales (npm run db:apply). Nunca en Vercel.
SUPABASE_ACCESS_TOKEN=
# Token de Vercel (Account > Tokens) para revisar variables y logs. Nunca en Vercel.
VERCEL_TOKEN=

# Chat PIN pepper (server only, >= 32 chars). Without it the chat PIN routes answer 503.
# Generate with: openssl rand -hex 32
CHAT_PIN_PEPPER=
