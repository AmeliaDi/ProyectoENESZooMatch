{
  "name": "enes-zoomatch",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run secrets:check && npm run lint && npm run typecheck && npm run test",
    "secrets:check": "node --no-warnings scripts/secrets-check.mts",
    "hooks:install": "git config core.hooksPath .githooks",
    "data:literature": "node --no-warnings scripts/literature/run.mts",
    "data:validate": "vitest run src/config src/infrastructure/supabase/schema.test.ts src/domain/avatars/archetype-catalog.test.ts",
    "db:reset": "supabase db reset",
    "db:apply": "node scripts/db-apply.mjs",
    "data:layers": "node --no-warnings scripts/literature/layers.mts",
    "data:matching": "node --no-warnings scripts/matching/run.mjs --write",
    "data:avatars": "node --no-warnings scripts/avatars/run.mjs",
    "data:bank": "python scripts/psychometrics/bank.py",
    "data:psychometrics": "python scripts/psychometrics/bank.py && python scripts/psychometrics/run.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
