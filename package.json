{
  "name": "enes-zoomatch",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run secrets:check && npm run lint && npm run typecheck && npm run test",
    "secrets:check": "node --no-warnings scripts/secrets-check.mts",
    "hooks:install": "git config core.hooksPath .githooks",
    "data:literature": "node --no-warnings scripts/literature/run.mts",
    "data:validate": "npm run data:schemas && node --no-warnings scripts/validation/run.mjs",
    "data:schemas": "vitest run src/config src/infrastructure/supabase/schema.test.ts src/domain/avatars/archetype-catalog.test.ts scripts/validation",
    "data:meta": "python scripts/literature/meta.py",
    "db:reset": "supabase db reset",
    "db:apply": "node scripts/db-apply.mjs",
    "data:layers": "node --no-warnings scripts/literature/layers.mts",
    "data:matching": "node --no-warnings scripts/matching/run.mjs --write",
    "data:avatars": "node --no-warnings scripts/avatars/run.mjs",
    "data:bank": "python scripts/psychometrics/bank.py",
    "data:psychometrics": "python scripts/psychometrics/bank.py && python scripts/psychometrics/run.py",
    "qa:chat:setup": "node --no-warnings scripts/qa/qa-chat-setup.mjs",
    "qa:chat:teardown": "node --no-warnings scripts/qa/qa-chat-teardown.mjs",
    "qa:chat": "vitest run scripts/qa/chat-e2e.test.ts",
    "qa:chat:quick": "vitest run scripts/qa/chat-e2e.test.ts --reporter=basic",
    "qa:chat:soak": "node --no-warnings scripts/qa/qa-chat-soak.mjs",
    "qa:chat:load": "node --no-warnings scripts/qa/chat-load.mjs",
    "qa:chat:sla": "vitest run scripts/qa/chat-sla.test.ts",
    "qa:chat:canary": "node --no-warnings scripts/qa/chat-canary.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.2",
    "pixscii": "^0.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true
  }
}
